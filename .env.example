# API Key 推荐使用 scripts/configure-agent.ps1 加密保存，也可通过进程环境变量提供。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AGENT_THINKING=off
AGENT_TOOLS=*
AGENT_ENABLE_WRITES=1
AGENT_AUTO_SUMMARY=1
AGENT_KEEP_TURNS=2
AGENT_RESTORE_SESSION=1
AGENT_ENABLE_MEDIA=1
# 不填写时保存在项目的 .agent-state 下，按设备地址和账号隔离。
# AGENT_STATE_DIR=
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOLS=8
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_TOKEN_BUDGET=200000
AGENT_TURN_TIMEOUT_MS=180000
AGENT_REQUEST_TIMEOUT_MS=60000
AGENT_CONTEXT_CHARS=60000
T830_BASE_URL=http://192.168.0.1
T830_USERNAME=admin
# 默认 cgi；本固件 CGI 登录异常时可显式用 ubus（需要原始管理密码）。
# ubus 模式已验证 RPC 工具；部分 CGI 路径仍会拒绝访问。
T830_AUTH_TRANSPORT=cgi
# 可选开发者认证：推荐 start-agent.ps1 --developer 隐藏输入，仅在当前进程中使用。
# 不要将真实密钥保存在此文件。
# T830_DEVELOPER_KEY=
T830_COOKIE_MODE=auto

# 独立媒体服务：npm run media。服务 Key 只由媒体进程读取，不传给 MCP/对话模型。
MEDIA_PORT=18790
# 千问官方 Omni：推荐 scripts/configure-media.ps1 将 Key 加密保存。
# 环境变量可覆盖加密配置；不要把真实 Key 提交到仓库。
# MEDIA_OMNI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# MEDIA_OMNI_MODEL=qwen3-omni-flash
# MEDIA_OMNI_API_KEY=
# MEDIA_TTS_VOICE=Cherry
# 本地 Hi Claude 唤醒与声纹模型（默认 .tools/voice，安装脚本 scripts/setup-voice.ps1）
# MEDIA_VOICE_MODELS_DIR=C:\path\to\voice
# MEDIA_VOICE_PYTHON=C:\path\to\python.exe
# 本地保存提交片段、失败唤醒和转写结果；最近约 100 条，默认关闭。
# MEDIA_VOICE_DIAGNOSTICS=1
# MEDIA_STATE_DIR=
# 摄像头监测图文记录的默认目录为项目 reports/monitoring。
# MEDIA_REPORT_DIR=
# Windows 默认自动使用项目 .tools/ffmpeg/ffmpeg.exe；以下配置可覆盖。
# MEDIA_FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe
# Base URL 必须包含服务所需的前缀（例如 /v1）；以下为兼容协议，需核对服务商。
# ASR: POST /audio/transcriptions，multipart WAV → JSON {text}
# MEDIA_ASR_BASE_URL=
# MEDIA_ASR_MODEL=
# MEDIA_ASR_API_KEY=
# TTS: POST /audio/speech，JSON → PCM16 WAV；默认 voice=alloy
# MEDIA_TTS_BASE_URL=
# MEDIA_TTS_MODEL=
# MEDIA_TTS_API_KEY=
# MEDIA_TTS_VOICE=alloy
# VISION: POST /chat/completions，image_url data URL → choices[0].message.content
# MEDIA_VISION_BASE_URL=
# MEDIA_VISION_MODEL=
# MEDIA_VISION_API_KEY=
